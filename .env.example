# Transcription auto selects OpenAI, then Groq, otherwise local whisper.cpp.
# Summary auto selects Anthropic, then OpenAI, then Groq, otherwise local Ollama.
# Set both to local to guarantee offline operation even when keys are present.
TRANSCRIPTION_PROVIDER=auto
SUMMARY_PROVIDER=auto
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-4-6
OPENAI_SUMMARY_MODEL=gpt-4o-mini
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
# Absolute paths recommended for packaged apps; ~ is supported.
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
WHISPER_BIN=~/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=~/whisper.cpp/models/ggml-medium.bin
WHISPER_LANGUAGE=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Transcript split across requests to fit local context windows.
SUMMARY_CHUNK_CHARS=12000
